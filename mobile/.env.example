# Dinamic Inventory mobile client — environment example
# Copy to .env for local development builds. Never commit real values.

# Base URL of the EXISTING backend (same API used by the web frontend).
# These values are read at build time via app.config.ts `extra` and exposed to the
# app through expo-constants. After changing this file, restart Metro with a clean
# cache (`npx expo start --dev-client --clear`) so the new `extra` is picked up.
#
# Prefer DINAMIC_API_BASE_URL. EXPO_PUBLIC_API_BASE_URL is accepted as an alias.
# Examples:
#   DINAMIC_API_BASE_URL=http://10.0.2.2:8000       # Android EMULATOR -> host localhost
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000   # same (alias)
#   DINAMIC_API_BASE_URL=http://10.0.3.2:8000       # Genymotion
#   DINAMIC_API_BASE_URL=http://127.0.0.1:8000      # PHYSICAL device + USB: run `adb reverse tcp:8000 tcp:8000`
#   DINAMIC_API_BASE_URL=http://192.168.1.50:8000   # PHYSICAL device Wi‑Fi -> host LAN IP (API must bind 0.0.0.0)
#   DINAMIC_API_BASE_URL=https://api.dinamic.example
# NOTE: Without adb reverse, 127.0.0.1 on a physical phone is the phone itself — not your Mac.
# After changing this file: restart Metro with cache clear (`npm start -- --clear`).
# Release/production builds must use HTTPS to the deployed API — never ship a LAN IP.
DINAMIC_API_BASE_URL=http://10.0.2.2:8000
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Optional: API key ONLY if the backend has API_KEY set (X-API-Key header).
# Leave empty when the deployment does not enforce a global API key.
DINAMIC_API_KEY=

# development | staging | production
# Use development for local http:// API (production forces HTTPS + disables cleartext).
DINAMIC_ENVIRONMENT=development

# Versioning (optional; defaults in app.config.ts)
# DINAMIC_VERSION_NAME=0.3.0
# DINAMIC_VERSION_CODE=30

# Feature flags (1/0). Defaults are permissive for piloto.
# DINAMIC_FLAG_MOBILE_DATA=1
# DINAMIC_FLAG_HEIC_JPEG=1
# DINAMIC_FLAG_WORK_MANAGER=1
# DINAMIC_FLAG_RECONCILE=1
# DINAMIC_FLAG_BG_POLL=1
# DINAMIC_FLAG_AISLE_LOCK=0
# DINAMIC_FLAG_UPLOAD_OBS=1
# Phase 1 upload optimizations: default ON in development/staging, OFF in production (opt-in).
# Set =1 to enable in production; set =0 to force off in non-prod.
# DINAMIC_FLAG_UPLOAD_DIM_CAP=1
# DINAMIC_FLAG_UPLOAD_ADAPTIVE_QUALITY=1
# DINAMIC_FLAG_UPLOAD_ADAPTIVE_CONCURRENCY=1
# Phase 2 background upload: default ON in development/staging, OFF in production (opt-in).
# DINAMIC_FLAG_BG_UPLOAD_WORKER=1
# DINAMIC_FLAG_BG_UPLOAD_FGS=1
# DINAMIC_FLAG_BG_UPLOAD_REBOOT=1
# Phase 3 local CODE_SCAN shadow (default OFF everywhere; hard opt-in).
# DINAMIC_FLAG_LOCAL_CODE_SCAN=1
# DINAMIC_FLAG_LOCAL_CODE_SCAN_COMPARE=1
# Phase 4 preliminary draft sync (default OFF; diagnostic only; JS scheduler, no WorkManager).
# DINAMIC_FLAG_PRELIMINARY_SYNC=1
# Phase 5 authoritative local CODE_SCAN (default OFF; operator-confirmed results).
# DINAMIC_FLAG_AUTHORITATIVE_LOCAL_CODE_SCAN=1
# DINAMIC_FLAG_LOCAL_RESULT_REVIEW=1
# Phase 6 authoritative aisle finalization (default OFF).
# DINAMIC_FLAG_AUTHORITATIVE_AISLE_FINALIZATION=1
# DINAMIC_FLAG_AUTHORITATIVE_FINALIZATION_OFFLINE_QUEUE=1

# Phase 7 — optional server reprocess (default off)
# DINAMIC_FLAG_MOBILE_SERVER_REPROCESS=1
# DINAMIC_FLAG_MOBILE_SERVER_REPROCESS_REVIEW=1
# DINAMIC_FLAG_SERVER_REPROCESS_OFFLINE_QUEUE=1

# Phase 8 — aisle corrections / history (default off)
# DINAMIC_FLAG_MOBILE_AISLE_REVISIONS=1
# DINAMIC_FLAG_MOBILE_AISLE_HISTORY=1
# DINAMIC_FLAG_SERVER_AISLE_REVISIONS=1
# DINAMIC_FLAG_SERVER_AISLE_ROLLBACK=1

# Phase 9 — unified offline_operations ledger (default off)
# DINAMIC_FLAG_MOBILE_OFFLINE_OPERATIONS=1
# DINAMIC_FLAG_MOBILE_OFFLINE_WORKMANAGER=1
# DINAMIC_FLAG_MOBILE_OFFLINE_FINALIZATION=1
# DINAMIC_FLAG_MOBILE_OFFLINE_REVISIONS=1
# DINAMIC_FLAG_MOBILE_OFFLINE_SERVER_PROCESSING=1
# DINAMIC_FLAG_SERVER_OFFLINE_IDEMPOTENCY_SUPPORT=1
#
# Phase 10 — incompatible combinations fail-fast at bootstrap:
#   OFFLINE_WM requires OFFLINE_OPERATIONS
#   Do NOT enable both AUTHORITATIVE_FINALIZATION_OFFLINE_QUEUE and MOBILE_OFFLINE_FINALIZATION
#   Do NOT enable both SERVER_REPROCESS_OFFLINE_QUEUE and MOBILE_OFFLINE_SERVER_PROCESSING
#
# Phase 10 — optional cutover / alert thresholds (Expo extra.cutover or env in tests)
# DINAMIC_CUTOVER_MIN_SUCCESS_RATE=0.99
# DINAMIC_CUTOVER_MAX_ERROR_RATE=0.01
# DINAMIC_ALERT_QUEUE_DEPTH_WARNING=100
# DINAMIC_ALERT_QUEUE_DEPTH_CRITICAL=500
