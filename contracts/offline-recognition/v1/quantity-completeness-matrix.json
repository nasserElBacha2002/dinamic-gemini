{
  "schema_version": 1,
  "description": "Single decision table for ITEM quantity completeness. Backend and mobile must emit the same identity_complete / completion_complete / persistence_complete / missing fields / fallback_eligible. POSITION never requires quantity. Never invent quantity=0 or quantity=1.",
  "algorithm": {
    "quantity_required_for_completion": [
      "POSITION → false",
      "required=true OR expected_presence=ALWAYS OR 'quantity' in required_fields → true",
      "missing_quantity_action=RESOLVE_CODE_ONLY (and not explicitly required) → false",
      "OPTIONAL and not explicitly required: EXTERNAL_FALLBACK or allow_external_fallback → true, else false",
      "missing_quantity_action=EXTERNAL_FALLBACK → true",
      "missing_quantity_action=PENDING_MANUAL_REVIEW or UNRECOGNIZED → true",
      "else allow_external_fallback"
    ],
    "fallback_eligible": "identity_complete AND quantity missing AND quantity_required_for_completion AND (allow_external_fallback OR missing_quantity_action=EXTERNAL_FALLBACK)"
  },
  "rows": [
