      "required": true,
      "expected_presence": "ALWAYS",
      "missing_quantity_action": "PENDING_MANUAL_REVIEW",
      "allow_external_fallback": false,
      "required_fields": ["label_id", "quantity"],
      "fields": { "label_id": "PRD-123456", "quantity": null },
      "expected": {
        "quantity_required_for_completion": true,
        "identity_complete": true,
        "completion_complete": false,
        "persistence_complete": false,
        "missing_completion_fields": ["quantity"],
        "fallback_eligible": false
      }
    },
