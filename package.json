{
  "name": "dinamic-gemini",
  "private": true,
  "description": "Run frontend and backend together for local development",
  "scripts": {
    "dev": "concurrently -n be,fe -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node scripts/run-backend.js",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript-eslint": "^8.59.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "@babel/core": "^7.29.7"
  }
}
