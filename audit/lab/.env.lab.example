# =============================================================================
# Dinamic Gemini — disposable Phase 4B lab env (TEMPLATE ONLY)
# Copy to audit/lab/.env.lab (gitignored). NEVER use for DEV/staging/production.
# =============================================================================

APP_ENV=local
V3_RUNTIME_ENVIRONMENT=local

# --- SQL Server (loopback lab container on 14333) ---
SQLSERVER_ENABLED=true
SQLSERVER_SERVER=127.0.0.1,14333
SQLSERVER_DATABASE=dinamic_gemini_lab
SQLSERVER_UID=sa
SQLSERVER_PWD=Lab_Only_ChangeMe_123
SQLSERVER_DRIVER='ODBC Driver 17 for SQL Server'
TrustServerCertificate=yes
# Compose SA password (must match SQLSERVER_PWD for lab_up create-db):
MSSQL_SA_PASSWORD=Lab_Only_ChangeMe_123

# Fail closed: SQL required (no in-memory fallback for lab)
V3_ALLOW_IN_MEMORY_FALLBACK=false

# --- Local artifact storage only (never s3/gcs) ---
ARTIFACT_STORAGE_PROVIDER=local
# Relative to repo root when API is started from backend/ with this env loaded
OUTPUT_DIR=../audit/lab/data/output

# Embedded worker in the same uvicorn process (simpler for lab).
# For a dedicated worker process, set EMBEDDED_WORKER_ENABLED=false and run worker separately.
EMBEDDED_WORKER_ENABLED=true

# --- Lab-only admin (password: LabAdmin!Only) ---
# Generate another hash:  cd backend && .venv/bin/python -c \
#   "from passlib.context import CryptContext; print(CryptContext(schemes=['pbkdf2_sha256']).hash('YOUR_PASSWORD'))"
ADMIN_USERNAME=lab_platform
# Single-quoted so bash `source` does not expand $pbkdf2...
ADMIN_PASSWORD_HASH='$pbkdf2-sha256$29000$ak2Jcc45R2jt3fu/lzImxA$QGGqP4SyMMvlX6qrjpK5qu0AkcB8L6tNc7VlFD1QupA'
AUTH_TOKEN_SECRET=lab-only-not-for-prod
AUTH_TOKEN_EXPIRE_MINUTES=480

# --- Lab attestation / fail-closed markers ---
LAB_DISPOSABLE_ENABLED=true
LAB_RUN_ID=
LAB_LLM_MOCKED=true
LAB_SEED_LOADED=false
LAB_FIXTURE_KEY_MARKER=lab-fixture-only

# Empty LLM keys — lab_preflight / lab start refuse real provider keys.
# If you must set a placeholder for schema validation, use ONLY the fixture marker value.
# Fixture marker is allowed by lab_preflight / attestation (not a real provider secret).
LLM_PROVIDER=gemini
GEMINI_API_KEY=lab-fixture-only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Developer .env may enable Claude fallback — force off for disposable lab.
EXTERNAL_FALLBACK_PER_IMAGE_ENABLED=false
CODE_SCAN_VISION_FALLBACK_ENABLED=false
EXTERNAL_FALLBACK_PROVIDER=
EXTERNAL_FALLBACK_MODEL=

# Bind hints (documentational; uvicorn host is set on the CLI)
LAB_API_HOST=127.0.0.1
LAB_API_PORT=18080
