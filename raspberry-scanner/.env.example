# Keep this empty until the scanner is identified on the Raspberry. Prefer its
# stable /dev/serial/by-id/... path; do not guess /dev/ttyUSB0.
SCANNER_DEVICE=
# Confirm the baud rate against the physical scanner documentation/test.
SCANNER_BAUD_RATE=9600
SCANNER_PORT=8080
SCANNER_MAX_READINGS=100

# Camera (phase 1): unconfigured | fake (dev/tests without hardware)
DINAMIC_CAMERA_MODE=unconfigured
# Durable per-session metadata (survives restart; one JSON file per session)
# DINAMIC_CAPTURE_SESSIONS_DIRECTORY=/var/lib/dinamic-raspberry-scanner/capture-sessions
# DINAMIC_PHOTOS_DIRECTORY=/var/lib/dinamic-raspberry-scanner/exports/photos
# Raspberry Pi camera via rpicam-still (libcamera):
# DINAMIC_CAMERA_MODE=rpicam
# DINAMIC_CAMERA_CAPTURE_DELAY_MS=1
# DINAMIC_CAMERA_PROCESS_TIMEOUT_SEC=30
# DINAMIC_CAMERA_COMMAND=rpicam-still
