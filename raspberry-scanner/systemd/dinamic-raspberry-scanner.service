[Unit]
Description=Dinamic Raspberry local scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dinamic
WorkingDirectory=/opt/dinamic-raspberry-scanner
EnvironmentFile=/etc/dinamic-raspberry-scanner.env
ExecStart=/usr/bin/python3 /opt/dinamic-raspberry-scanner/app.py --host 0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
