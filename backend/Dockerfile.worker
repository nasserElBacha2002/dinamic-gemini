# syntax=docker/dockerfile:1.4
FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Same SQL Server ODBC stack as Dockerfile (multi-arch Microsoft repo; no [arch=amd64] pin).
RUN apt-get update && apt-get install -y --no-install-recommends \
    apt-transport-https \
    build-essential \
    ca-certificates \
    curl \
    git \
    gnupg \
    libglib2.0-0 \
    libgssapi-krb5-2 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libxcb1 \
    libgl1 \
    libzbar0 \
    tesseract-ocr \
    tesseract-ocr-spa \
    tesseract-ocr-eng \
    unixodbc \
    unixodbc-dev \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /etc/apt/keyrings/microsoft.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" > /etc/apt/sources.list.d/microsoft-prod.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && echo "msodbcsql18 image arch audit: $(dpkg --print-architecture)" \
    && dpkg -s msodbcsql18 | grep -E '^Package:|^Version:|^Architecture:' \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
COPY docker/verify_worker_runtime_deps.py /tmp/verify_worker_runtime_deps.py

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    && python /tmp/verify_worker_runtime_deps.py \
    && rm -f /tmp/verify_worker_runtime_deps.py

# Non-root user (uid/gid 10001) before COPY so --chown avoids recursive chown.
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/output \
    && chown appuser:appuser /app /app/output

COPY --chown=appuser:appuser . .
USER appuser

CMD ["python", "-m", "src.jobs.run_worker"]
